# ==========================================
# TRUSTLENS ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# JWT Secret for Session Authentication
JWT_SECRET=trustlens-secure-super-secret-key-2026-production

# Supabase PostgreSQL Configuration (Optional: SQLite is used as local zero-config fallback)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Google Gemini API Key (Optional: when omitted, TrustLens uses explainable deterministic linguistic engine)
GEMINI_API_KEY=your-gemini-api-key-here

# Client URL for CORS
CLIENT_URL=http://localhost:3000

# OCR Debug Logs (Optional: 1 to print detailed OCR progress steps)
DEBUG_OCR=0
